# Copy to .env (local) or set on the server. Never commit real values.

# Email through Resend (project briefs to contact@dacnis.tn, applications to hr@dacnis.tn).
RESEND_API=

# Careers store: offers, applications and CVs. Use a folder OUTSIDE the app directory in
# production so a redeploy never erases it, and include it in your backups.
# Default: ./.data
DATA_DIR=

# Careers dashboard (/dashboard). One account.
# Generate AUTH_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing ADMIN_PASSWORD signs out every open session.
ADMIN_EMAIL=hr@dacnis.tn
ADMIN_PASSWORD=
AUTH_SECRET=

# Optional: automatic WhatsApp alert for each new application (WhatsApp Business Cloud API).
# Leave empty to disable. See README.md, "WhatsApp alerts".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Numbers that receive the alert, international format without "+", comma separated.
WHATSAPP_ALERT_TO=+21655000359
# Optional: approved template name and language (defaults: nouvelle_candidature, fr).
# WHATSAPP_TEMPLATE=nouvelle_candidature
# WHATSAPP_TEMPLATE_LANG=fr
